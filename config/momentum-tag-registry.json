{
  "schema_version": 1,
  "registry_id": "momentum_surge_tag_registry_v1",
  "description": "動能飆股觀察標籤。僅使用訊號日當下或更早可得資料；不把市場牛熊作為入選條件。",
  "tags": [
    {
      "tag_id": "momentum_score_50_v1",
      "family_id": "momentum_score_50",
      "version": 1,
      "label": "動能分數至少 50",
      "category": "momentum_internal",
      "fixed_display": false,
      "enabled": true,
      "rule": {
        "path": "strategy_tag_features.momentum_score",
        "operator": "gte",
        "value": 50
      }
    },
    {
      "tag_id": "momentum_score_65_v1",
      "family_id": "momentum_score_65",
      "version": 1,
      "label": "動能分數至少 65",
      "category": "momentum_internal",
