      "version": 1,
      "label": "動能準備",
      "category": "momentum",
      "fixed_display": true,
      "enabled": true,
      "description": "Momentum Score 50–64；動能條件開始累積，但尚未進入加速區。",
      "expression": {
        "all": ["momentum_score_50_v1"],
        "any": [],
        "not": ["momentum_score_65_v1"]
      }
    },
    {
      "tag_id": "momentum_accelerating_v1",
      "family_id": "momentum_accelerating",
      "version": 1,
      "label": "動能加速",
      "category": "momentum",
      "fixed_display": true,
      "enabled": true,
      "description": "Momentum Score 65–79；價量、趨勢或籌碼已形成較明顯共振。",
      "expression": {
        "all": ["momentum_score_65_v1"],
        "any": [],
        "not": ["momentum_score_80_v1"]
      }
    },
    {
      "tag_id": "momentum_surge_v1",
      "family_id": "momentum_surge",
      "version": 1,
