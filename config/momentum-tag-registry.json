      "enabled": true,
      "rule": {
        "path": "strategy_tag_features.momentum_score",
        "operator": "gte",
        "value": 65
      }
    },
    {
      "tag_id": "momentum_score_80_v1",
      "family_id": "momentum_score_80",
      "version": 1,
      "label": "動能分數至少 80",
      "category": "momentum_internal",
      "fixed_display": false,
      "enabled": true,
      "rule": {
        "path": "strategy_tag_features.momentum_score",
        "operator": "gte",
        "value": 80
      }
