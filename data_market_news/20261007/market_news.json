      "guid": "https://tw.stock.yahoo.com/news/%E6%84%9B%E7%88%BE%E8%98%AD%E8%83%BD%E6%BA%90%E6%B8%9B%E7%A8%85%E6%8E%AA%E6%96%BD%E5%BB%B6%E8%87%B32027%E5%B9%B42%E6%9C%88%E5%BA%95-%E6%96%B0%E6%8A%95%E8%B3%87%E5%B8%B3%E6%88%B6%E8%A8%AD5%E8%90%AC%E6%AD%90%E5%85%83%E5%85%8D%E7%A8%85%E9%A1%8D-235205805.html",
